@echo off
setlocal

rem ====================================================================
rem  SAM Scheduler 서버 실행 파일.
rem
rem  [이 파일을 고칠 때 지켜야 하는 인코딩 규칙]
rem  이 파일은 반드시 CP949(euc-kr) 로 저장하고, 안에서 chcp 를 부르지 마십시오.
rem  cmd.exe 는 배치 파일을 바이트 위치로 좇아가며 한 줄씩 읽는데, 실행 도중
rem  코드페이지가 바뀌면 그 위치 계산이 어긋나 줄 중간부터 읽습니다. 그러면 rem
rem  주석의 한 토막이 명령으로 해석되어 "'상태에서도' is not recognized" 같은
rem  오류가 창에 쏟아집니다. 한국어 윈도우의 콘솔 기본 코드페이지가 949 이므로,
rem  파일을 949 로 저장해 두면 chcp 없이도 한글이 그대로 나옵니다.
rem  (UTF-8 로 저장하고 chcp 65001 을 부르던 첫 판이 실제로 그 오류를 냈습니다.)
rem
rem  sp-server.exe 를 직접 더블 클릭하지 말고 이 파일로 실행하십시오.
rem  자세한 설명은 README.txt 2절 [콘솔 창을 클릭하면 서버가 멈춥니다] 에 있습니다.
rem
rem  요지: 윈도우 콘솔은 "빠른 편집 모드" 가 기본으로 켜져 있어서, 검은 창 안을
rem  마우스로 클릭하면 글자를 선택하는 상태로 들어갑니다. 그 상태에서는 그 창으로
rem  글자를 내보내려는 프로그램이 그 자리에 멈춰 서고, 사람이 선택을 풀 때까지
rem  되살아나지 않습니다. Node.js 는 콘솔 출력을 기다렸다가 처리하는 방식이라,
rem  서버 전체가 함께 멈춥니다. 화면은 응답을 받지 못해 로딩 상태로 남고, 매시
rem  정각에 도는 예약 작업도 발화하지 않습니다.
rem  (2026-09-10 고객 서버에서 1시간 54분 동안 멈춘 사고의 원인이 이것이었습니다.)
rem
rem  그래서 이 파일은 서버의 화면 출력을 창이 아니라 logs\sp-console.log 파일로
rem  보냅니다. 내보낼 곳이 창이 아니면 선택 상태에서도 멈추지 않으므로, 창을
rem  클릭하더라도 서버는 계속 돌아갑니다. 잃는 기록은 없습니다. 서버는 같은
rem  내용을 logs\sp-2026-09-10.log 형식의 날짜별 파일에 스스로 남깁니다.
rem ====================================================================

rem 작업 폴더를 이 파일이 있는 곳으로 맞춥니다. data\, logs\, backups\ 가 모두
rem 작업 폴더를 기준으로 만들어지므로, 이 줄이 없으면 바로 가기로 실행했을 때
rem 데이터 폴더가 엉뚱한 위치에 생깁니다.
cd /d "%~dp0"

if not exist "sp-server.exe" (
  echo.
  echo   [오류] 이 파일과 같은 폴더에 sp-server.exe 가 없습니다.
  echo          배포용 zip 을 풀어 나온 seedcore-proj 폴더를 통째로 옮겨서 쓰십시오.
  echo.
  pause
  exit /b 9
)

if not exist "logs" mkdir "logs"

echo ====================================================
echo   SAM Scheduler 서버를 시작합니다.
echo ====================================================
echo.
echo   접속 주소 - 브라우저에서 여십시오
echo     - 이 PC 에서    : http://localhost:3000
for /f "tokens=2 delims=:" %%A in ('ipconfig ^| findstr /C:"IPv4"') do (
  for /f "tokens=*" %%B in ("%%A") do echo     - 사내 다른 PC  : http://%%B:3000
)
echo.
echo   * 주소가 여러 개 보이면 사내망 대역에 해당하는 것을 쓰십시오.
echo     가상 네트워크 어댑터의 주소까지 함께 나옵니다.
echo   * 사내 다른 PC 에서 접속되지 않으면 윈도우 방화벽 인바운드 규칙에서
echo     TCP 3000 번 포트를 허용해 주십시오.
echo.
echo   서버를 멈출 때 : 이 창에서 Ctrl+C 를 누르십시오.
echo                    "일괄 작업을 끝내시겠습니까" 물음에는 Y 를 누릅니다.
echo   살아 있는지 볼 때 : 위 접속 주소를 브라우저로 열어 보십시오.
echo   서버 메시지    : 이 창에는 나오지 않습니다. 일부러 그렇게 한 것입니다.
echo                    기록은 logs 폴더의 sp-console.log 와 sp-날짜.log 에 쌓입니다.
echo.
echo ====================================================
echo   서버가 실행 중입니다. 이 창을 닫지 마십시오.
echo   이 창을 클릭해도 서버는 멈추지 않습니다.
echo ====================================================

rem 화면 출력을 파일로 보내는 것이 이 파일의 핵심입니다. 위 주석의 이유로
rem 반드시 유지해야 합니다. 이어 붙이지 않고 덮어쓰는 이유는, 이 파일에만 있는
rem 정보가 "가장 최근 기동의 접속 주소와 설정 안내" 뿐이고 나머지 기록은 서버가
rem 날짜별 파일에 남기기 때문입니다. 이어 붙이는 방식으로 두면, 자동 정리 대상이
rem 아닌 이 파일이 끝없이 자라기만 합니다.
rem
rem 주의: rem 주석 안에도 리다이렉트 기호를 적지 마십시오. cmd.exe 는 rem 줄의
rem 내용을 버리기 전에 리다이렉트 토큰을 먼저 갈라내므로, 주석에 적어 둔 기호가
rem 명령으로 해석되어 "'는' is not recognized" 같은 오류가 창에 쏟아집니다.
rem 실제로 그렇게 새어 나온 적이 있습니다. 기호를 꼭 적어야 하면 말로 풀어 쓰십시오.
"%~dp0sp-server.exe" > "logs\sp-console.log" 2>&1
set "EXITCODE=%ERRORLEVEL%"

echo.
if "%EXITCODE%"=="0" (
  echo   서버가 정상 종료되었습니다.
) else (
  echo   [확인 필요] 서버가 종료 코드 %EXITCODE% 로 끝났습니다.
  echo   각 번호의 뜻은 README.txt 4절 [종료 코드 안내] 에 정리되어 있습니다.
  echo.
  echo   ---- 서버가 남긴 마지막 메시지 - logs\sp-console.log ----
  rem 서버는 이미 끝났으므로 이 출력이 무언가를 멈출 걱정은 없다. 기동 실패의 원인은
  rem 이 파일에만 남으므로, 창에 그대로 펼쳐 주지 않으면 관리자가 종료 코드 번호만
  rem 보고 원인을 찾아 헤매게 된다.
  if exist "logs\sp-console.log" type "logs\sp-console.log"
  echo   ----------------------------------------------------------
  echo.
  echo   위 내용과 logs 폴더의 sp-날짜.log 를 함께 보내 주시면 원인을 찾을 수 있습니다.
  echo.
  pause
)
exit /b %EXITCODE%

# --- 서버 ---
PORT=3000
NODE_ENV=development
# CORS 허용 출처이자, 세션 쿠키 Secure 속성의 판정 근거다
# (apps/api/src/common/cookie-security.ts — 왜 NODE_ENV 로 판단하지 않는지 설명 있음).
# https:// 로 시작할 때만 Secure 가 붙는다. 폐쇄망 exe 배포는 이 값이 비어 있어 자동으로 꺼진다.
WEB_ORIGIN=http://localhost:5173

# 위 유도를 덮어쓰는 탈출구. 보통은 비워둔다. 1 로 켜면 HTTPS 로만 로그인된다.
# COOKIE_SECURE=

# --- DB (SQLite) ---
# 운영(컨테이너) 기본 경로: file:/var/seedcore-scheduler/data/app.db
DATABASE_URL="file:./data/app.db"

# --- 세션 ---
# SESSION_SECRET 은 두지 않는다. 세션 id 는 crypto.randomUUID() 로 만들어 DB(sessions)에
# 저장하는 방식이라 서명 키가 필요 없다 (JWT·서명 쿠키를 쓰지 않는다 — AGENTS.md §4.4).
# 예전에는 "32바이트 이상으로 변경 필수" 라고 적혀 있었지만 코드에서 참조하는 곳이 없어,
# 관리자에게 실제로는 없는 보호막이 있는 것처럼 읽혔다.

# --- 초기 ADMIN (첫 기동 시 1회 시딩, 첫 로그인 시 패스워드 변경 강제) ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeMe!Now

# --- 백업 (DESIGN §7.1) — 자동 실행은 NestJS 스케줄러가 in-process 로 수행 ---
# BACKUP_DIR 을 비워두면 cwd 기준 data/backup 을 쓴다.
# BACKUP_DB_PATH 를 비워두면 DATABASE_URL 에서 뽑은 실제 DB 파일 경로를 쓴다 (위 --- DB --- 참고).
#   이 값은 부팅 로그 표시용이다. 실제 백업은 연결된 Prisma 클라이언트에 VACUUM INTO 를 걸므로
#   이 경로와 무관하게 항상 열려 있는 DB 를 뜬다.
# 운영 컨테이너에서는 절대경로 권장 (예: /var/seedcore-scheduler/data/app.db, /var/seedcore-scheduler/backup/daily).
BACKUP_DB_PATH=
BACKUP_DIR=
BACKUP_CRON="0 4 * * *"
BACKUP_RETENTION_DAYS=30

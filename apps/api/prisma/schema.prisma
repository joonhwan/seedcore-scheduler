// SAM Scheduler — Prisma schema (DESIGN §3.2)
// SQLite + Prisma. enum 미지원이라 모든 enum 류는 String + 애플리케이션 가드(zod) + 마이그레이션 CHECK 제약으로 표현.
// ID 는 UUIDv4 문자열을 애플리케이션에서 생성해 전달.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id
  username           String    @unique
  displayName        String    @map("display_name")
  passwordHash       String    @map("password_hash")
  passwordMustChange Boolean   @default(true) @map("password_must_change")
  globalRole         String    @default("USER") @map("global_role") // 'ADMIN' | 'USER'
  isActive           Boolean   @default(true) @map("is_active")
  preferencesJson    String?   @map("preferences_json")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  lastLoginAt        DateTime? @map("last_login_at")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until")
  // 퇴사 처리 시각. 비어 있으면 재직. 3차 작업(확정명세 ⑥)에서 쓰지만 마이그레이션을 한 번의
  // 배포로 묶기 위해 2차에서 함께 넣는다. 기본값을 주거나 NOT NULL 로 바꾸면 Prisma 가 users
  // 테이블을 재생성하는 경로를 택하므로 절대 바꾸지 말 것 (설계 문서 §11).
  retiredAt          DateTime? @map("retired_at")

  createdProjects    Project[]       @relation("ProjectCreatedBy")
  projectMemberships ProjectMember[] @relation("MembershipUser")
  membershipsAdded   ProjectMember[] @relation("MembershipAddedBy")
  nodesCreated       ScheduleNode[]  @relation("NodeCreatedBy")
  nodesUpdated       ScheduleNode[]  @relation("NodeUpdatedBy")
  comments           NodeComment[]
  history            NodeHistory[]
  auditLogs          AuditLog[]
  sessions           Session[]
  groupMemberships   UserGroupMember[] @relation("GroupMemberUser")
  groupMembersAdded  UserGroupMember[] @relation("GroupMemberAddedBy")
  serverNotices      ServerNotice[]    @relation("ServerNoticeCreatedBy")

  @@map("users")
}

model Project {
  id          String   @id
  name        String
  description String?
  status      String   @default("ACTIVE") // 'ACTIVE' | 'ARCHIVED'
  createdById String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User            @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  members   ProjectMember[]
  nodes     ScheduleNode[]

  @@map("projects")
}

model ProjectMember {
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String // 'MANAGER' | 'MEMBER'
  addedById String   @map("added_by")
  addedAt   DateTime @default(now()) @map("added_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("MembershipUser", fields: [userId], references: [id])
  addedBy User    @relation("MembershipAddedBy", fields: [addedById], references: [id])

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model ScheduleNode {
  id          String   @id
  projectId   String   @map("project_id")
  parentId    String?  @map("parent_id")
  kind        String // 'GROUP' | 'ITEM'
  title       String
  description String?
  startAt     String?  @map("start_at") // YYYY-MM-DD (ITEM 만 직접 입력)
  endAt       String?  @map("end_at")
  progress    Int      @default(0) // 0..100 (ITEM 만 직접 입력). GROUP 의 effective 는 자손 ITEM 단순평균. CHECK 제약은 마이그레이션에서 추가
  sortOrder   Int      @map("sort_order")
  depth       Int // 0..9 (MAX_TREE_DEPTH=10). 검증은 애플리케이션(nodes.service)에서만 한다 — DB CHECK 제약은 없다
  createdById String   @map("created_by")
  updatedById String   @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    ScheduleNode?  @relation("NodeTree", fields: [parentId], references: [id])
  children  ScheduleNode[] @relation("NodeTree")
  createdBy User           @relation("NodeCreatedBy", fields: [createdById], references: [id])
  updatedBy User           @relation("NodeUpdatedBy", fields: [updatedById], references: [id])
  comments  NodeComment[]
  history   NodeHistory[]

  @@index([projectId, parentId, sortOrder])
  @@map("schedule_nodes")
}

model NodeComment {
  id        String    @id
  nodeId    String    @map("node_id")
  authorId  String    @map("author_id")
  body      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  node   ScheduleNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorId], references: [id])

  @@index([nodeId, createdAt])
  @@map("node_comments")
}

model NodeHistory {
  id                String   @id
  nodeId            String?  @map("node_id") // 노드 삭제 후엔 null. 조회는 nodeIdSnapshot 으로.
  nodeIdSnapshot    String   @map("node_id_snapshot") // 항상 채워지는 원본 nodeId. 삭제 후 history 검색용.
  projectIdSnapshot String   @map("project_id_snapshot") // 프로젝트 단위 history 조회용 (프로젝트가 삭제되면 cascade 로 row 가 사라지지 않음 — projects.onDelete=Cascade 는 schedule_nodes 만 따라감)
  actorId           String   @map("actor_id")
  action            String // CREATE/UPDATE/MOVE/DELETE/RESTORE
  diffJson          String   @map("diff_json")
  occurredAt        DateTime @default(now()) @map("occurred_at")

  node  ScheduleNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  actor User          @relation(fields: [actorId], references: [id])

  @@index([nodeIdSnapshot, occurredAt])
  @@index([projectIdSnapshot, occurredAt])
  @@map("node_history")
}

model AuditLog {
  id          String   @id
  actorId     String?  @map("actor_id")
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  ip          String?
  userAgent   String?  @map("user_agent")
  occurredAt  DateTime @default(now()) @map("occurred_at")
  payloadJson String?  @map("payload_json")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([occurredAt])
  @@map("audit_logs")
}

model Session {
  sid        String   @id
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  expiresAt  DateTime @map("expires_at")
  ip         String?
  userAgent  String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AutocompleteTerm {
  id        String   @id
  title     String
  kind      String   // 'GROUP' | 'ITEM'
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([title, kind])
  @@map("autocomplete_terms")
}

// 사용자 그룹(부서). parent_id 하나로 조직 계층을 표현한다.
// @@unique([parentId, name]) 은 최상위끼리는 걸리지 않는다 — SQL 표준상 NULL 끼리는 같다고 보지
// 않기 때문이다. 최상위 이름 중복은 GroupsService 가 애플리케이션에서 검사한다.
model UserGroup {
  id          String   @id
  name        String
  parentId    String?  @map("parent_id")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   UserGroup?        @relation("GroupTree", fields: [parentId], references: [id])
  children UserGroup[]       @relation("GroupTree")
  members  UserGroupMember[]

  @@unique([parentId, name])
  @@map("user_groups")
}

// 그룹 소속. 운영은 1인 1소속이지만 구조는 여러 소속을 허용해 둔다 (확정명세 ㉰).
// 그룹 쪽 onDelete 가 Cascade 인 것은 안전망일 뿐이다 — 인원이 남아 있으면 서버가 그룹 삭제
// 자체를 거부하므로 실제로 발동하지 않는다.
model UserGroupMember {
  groupId   String   @map("group_id")
  userId    String   @map("user_id")
  addedById String   @map("added_by")
  addedAt   DateTime @default(now()) @map("added_at")

  group   UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User      @relation("GroupMemberUser", fields: [userId], references: [id])
  addedBy User      @relation("GroupMemberAddedBy", fields: [addedById], references: [id])

  @@id([groupId, userId])
  @@index([userId])
  @@map("user_group_members")
}

/// 서버 공지. 지금은 재시작 예고(kind='RESTART') 하나만 쓴다.
///
/// 유효한 예고는 "canceled_at 이 비어 있는 것 중 created_at 이 가장 나중인 것" 하나다.
/// 예정 시각이 지나도 유효한 상태로 남는다 — 재시작이 몇 분 늦어지는 사이에 팝업이 사라지면
/// 사용자가 편집을 다시 시작해 작업을 잃기 때문이다(설계 문서 §4.3).
model ServerNotice {
  id          String    @id
  kind        String // 'RESTART' — SQLite 는 enum 이 없어 CHECK 로 제한한다
  message     String
  scheduledAt DateTime  @map("scheduled_at")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  canceledAt  DateTime? @map("canceled_at")

  creator User @relation("ServerNoticeCreatedBy", fields: [createdBy], references: [id])

  @@map("server_notices")
}


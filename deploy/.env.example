# --- 외부 노출 포트 ---
HTTP_PORT=8080

# --- 서버 ---
NODE_ENV=production
# WEB_ORIGIN 은 **브라우저가 실제로 치는 주소**여야 한다. CORS 뿐 아니라 세션 쿠키의 Secure
# 속성 판정에도 쓰인다 (apps/api/src/common/cookie-security.ts).
#   http://...  → Secure 안 붙임. 평문 HTTP 접속 가능
#   https://... → Secure 붙임. HTTPS 로만 로그인됨
# deploy/nginx.conf 는 listen 80 뿐이라 TLS 종단이 없으므로 http 가 맞다.
# 사내 IP 로 접속시킬 거라면 그 주소로 바꾼다 (예: http://192.168.0.10:8080).
WEB_ORIGIN=http://localhost:8080

# 앞단에 TLS 종단을 따로 두면서 WEB_ORIGIN 은 내부 주소로 남겨야 하는 경우에만 1 로 켠다.
# 비워두면 위 WEB_ORIGIN 의 스킴에서 자동으로 정해진다 — 보통은 비워두는 것이 맞다.
# 잘못 켜면 평문 HTTP 접속자 전원이 로그인 불가가 되고, 서버 PC 의 localhost 에서는
# 멀쩡히 되기 때문에 원인을 찾기 매우 어렵다.
# COOKIE_SECURE=

# --- DB (SQLite, 컨테이너 내부 경로) ---
DATABASE_URL=file:/var/seedcore-scheduler/data/app.db

# --- 세션 ---
# SESSION_SECRET 은 두지 않는다 — 세션 id 를 DB 에 저장하는 방식이라 서명 키가 필요 없다.
# (apps/api/.env.example 의 같은 항목 설명 참고)

# --- 초기 ADMIN ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeMe!Now

# --- 백업 (DESIGN §7.1) — 자동 실행은 NestJS 스케줄러가 in-process 로 수행 (Asia/Seoul TZ 고정) ---
# 기존 deploy/scripts/full-backup.sh 등 쉘 스크립트는 수동 백업/복원 fallback 으로만 사용.
BACKUP_DB_PATH=/var/seedcore-scheduler/data/app.db
BACKUP_DIR=/var/seedcore-scheduler/backup/daily
BACKUP_CRON="0 4 * * *"
BACKUP_RETENTION_DAYS=30

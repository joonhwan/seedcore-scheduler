{
  "name": "seedcore-scheduler",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/**\" run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "db:reset-admin": "pnpm -F @sam/api reset-admin",
    "build:exe": "pnpm -F @sam/api build:exe"
  },
  "devDependencies": {
    "marked": "^18.0.2",
    "prettier": "3.3.3",
    "typescript": "5.6.3"
  }
}

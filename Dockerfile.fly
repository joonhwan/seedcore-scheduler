# syntax=docker/dockerfile:1.7
# Node 22 인 이유: corepack 이 package.json 의 packageManager(pnpm@11.17.0)를 그대로
# 받아오는데, pnpm 11 은 node:sqlite 를 쓰므로 Node >= 22.13 이 필요하다. 20 에서는
# 빌더의 `pnpm install` 이 ERR_UNKNOWN_BUILTIN_MODULE 로 죽는다. 런타임 단계도 시작할 때
# `pnpm prisma:migrate:deploy` 를 부르므로 같은 base 를 써야 한다.
FROM node:22-alpine AS base
RUN corepack enable && apk add --no-cache sqlite gzip tini openssl nginx
WORKDIR /app

# --- Web 빌드 단계 ---
FROM base AS builder-web
COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
RUN pnpm install --no-frozen-lockfile
COPY packages/shared ./packages/shared
COPY apps/web ./apps/web
RUN pnpm --filter @sam/shared build \
 && pnpm --filter @sam/web build

# --- API 빌드 단계 ---
FROM base AS builder-api
COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api/package.json ./apps/api/
# apps/api 의 postinstall 이 이 파일을 실행하므로 install 보다 먼저 들어와야 한다.
# (소스 전체는 캐시 효율 때문에 install 뒤에 복사한다. 이 한 파일만 예외.)
# 스크립트 자체는 prisma/schema.prisma 가 아직 없는 것을 알고 조용히 건너뛴다 —
# 아래에서 소스를 복사한 뒤 prisma:generate 를 명시적으로 부른다.
COPY apps/api/scripts/postinstall.js ./apps/api/scripts/
COPY packages/shared/package.json ./packages/shared/
RUN pnpm install --no-frozen-lockfile
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api
RUN pnpm --filter @sam/shared build \
 && pnpm --filter @sam/api prisma:generate \
 && pnpm --filter @sam/api build

# --- 최종 런타임 단계 ---
FROM base AS runtime
ENV NODE_ENV=production

# Nginx 설정 및 정적 리소스 복사
COPY deploy/nginx.fly.conf /etc/nginx/nginx.conf
COPY --from=builder-web /app/apps/web/dist /usr/share/nginx/html

# API 서버 복사
COPY --from=builder-api /app /app

# run-services 쉘 스크립트 작성
RUN printf '#!/bin/sh\n\
# Nginx PID 디렉토리 생성 및 권한 설정\n\
mkdir -p /run/nginx\n\
\n\
# 1. DB 마이그레이션 실행\n\
cd /app/apps/api\n\
pnpm prisma:migrate:deploy\n\
\n\
# 2. NestJS API 백서버 구동 (백그라운드)\n\
node dist/main.js &\n\
\n\
# 3. Nginx 포그라운드 구동\n\
nginx -g "daemon off;"\n' > /usr/local/bin/run-services.sh \
 && chmod +x /usr/local/bin/run-services.sh

WORKDIR /app/apps/api
EXPOSE 80

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["/usr/local/bin/run-services.sh"]
